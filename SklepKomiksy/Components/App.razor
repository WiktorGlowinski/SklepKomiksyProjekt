<!DOCTYPE html>
<html lang="pl" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-secondary-fixed": "#002113",
                        "on-secondary-container": "#00311f",
                        "outline": "#909097",
                        "inverse-surface": "#dae2fd",
                        "on-primary-fixed-variant": "#004395",
                        "primary-fixed-dim": "#adc6ff",
                        "surface-container-high": "#222a3d",
                        "inverse-primary": "#005ac2",
                        "outline-variant": "#45464d",
                        "surface-container-highest": "#2d3449",
                        "error": "#ffb4ab",
                        "surface-container-low": "#131b2e",
                        "on-surface": "#dae2fd",
                        "secondary-fixed-dim": "#4edea3",
                        "on-primary": "#002e6a",
                        "on-tertiary-container": "#f42f54",
                        "on-error": "#690005",
                        "inverse-on-surface": "#283044",
                        "surface-bright": "#31394d",
                        "on-secondary": "#003824",
                        "background": "#0b1326",
                        "on-background": "#dae2fd",
                        "on-surface-variant": "#c6c6cd",
                        "surface-tint": "#adc6ff",
                        "on-tertiary": "#68001a",
                        "surface": "#0b1326",
                        "surface-container": "#171f33",
                        "tertiary-container": "#39000a",
                        "surface-variant": "#2d3449",
                        "on-secondary-fixed-variant": "#005236",
                        "tertiary-fixed": "#ffdada",
                        "on-tertiary-fixed": "#40000c",
                        "on-error-container": "#ffdad6",
                        "on-tertiary-fixed-variant": "#920028",
                        "secondary-container": "#00a572",
                        "primary-container": "#00163a",
                        "surface-dim": "#0b1326",
                        "primary": "#adc6ff",
                        "error-container": "#93000a",
                        "surface-container-lowest": "#060e20",
                        "tertiary": "#ffb3b6",
                        "secondary": "#4edea3",
                        "secondary-fixed": "#6ffbbe",
                        "tertiary-fixed-dim": "#ffb3b6",
                        "on-primary-container": "#357df1",
                        "on-primary-fixed": "#001a42",
                        "primary-fixed": "#d8e2ff"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "fontFamily": {
                        "headline": ["Inter"],
                        "body": ["Inter"],
                        "label": ["Inter"]
                    }
                },
            },
        }
    </script>

    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0b1326; color: #dae2fd; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .glass-effect { background: rgba(45, 52, 73, 0.6); backdrop-filter: blur(20px); }
        .active-nav-bar { border-left: 2px solid #4edea3; }
        .primary-gradient { background: linear-gradient(135deg, #adc6ff 0%, #357df1 100%); }
    </style>

    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["SklepKomiksy.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />

</head>

<body class="flex overflow-hidden">
    <Routes @rendermode="PageRenderMode" />
    
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
