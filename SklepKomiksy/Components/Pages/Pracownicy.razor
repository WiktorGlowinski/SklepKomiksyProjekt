@page "/pracownicy"
@attribute [Authorize(Roles = "Wlasciciel")]
@using Microsoft.AspNetCore.Identity
@using SklepKomiksy.Data
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject AuthenticationStateProvider AuthStateProvider

<div class="mb-8">
    <h2 class="text-2xl font-black text-primary tracking-tight flex items-center gap-3">
        <span class="material-symbols-outlined">badge</span>
        Zarządzanie Zespołem
    </h2>
    <p class="text-on-surface-variant text-sm mt-1">Dodawaj nowych pracowników i zarządzaj dostępem do systemu.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10">
    
    <div class="lg:col-span-1">
        <div class="bg-surface-container-high rounded-2xl border border-outline-variant/10 p-6 shadow-lg">
            <div class="flex items-center gap-2 mb-6 border-b border-outline-variant/10 pb-4">
                <span class="material-symbols-outlined text-secondary">person_add</span>
                <h3 class="font-bold text-on-surface">Dodaj pracownika</h3>
            </div>

            @if (!string.IsNullOrEmpty(komunikat))
            {
                <div class="mb-4 px-4 py-3 rounded-lg text-sm font-medium border @(czyBlad ? "bg-error/10 text-error border-error/20" : "bg-secondary/10 text-secondary border-secondary/20")">
                    @komunikat
                </div>
            }

            <div class="space-y-4 mb-6">
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Login (Imię i Nazwisko)</label>
                    <input type="text" class="w-full bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:ring-1 focus:ring-primary focus:border-primary placeholder-on-surface-variant/40 transition-all" @bind="nowyLogin" placeholder="np. jan.kowalski" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Hasło startowe</label>
                    <input type="text" class="w-full bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:ring-1 focus:ring-primary focus:border-primary placeholder-on-surface-variant/40 transition-all" @bind="noweHaslo" placeholder="np. Pracownik123!" />
                    <p class="text-[10px] text-on-surface-variant/70 mt-1">Wymagane: duża litera, cyfra i znak specjalny.</p>
                </div>
            </div>
            
            <button class="w-full primary-gradient text-on-primary font-bold py-3 px-4 rounded-xl flex items-center justify-center gap-2 shadow-lg shadow-on-primary-container/20 hover:scale-[0.98] transition-transform" @onclick="ZarejestrujPracownika">
                <span class="material-symbols-outlined text-sm">how_to_reg</span>
                <span>Utwórz konto</span>
            </button>
        </div>
    </div>

    <div class="lg:col-span-2">
        <div class="bg-surface-container-high rounded-2xl border border-outline-variant/10 overflow-hidden shadow-lg h-full">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-surface-container-highest border-b border-outline-variant/10 text-on-surface-variant text-[11px] uppercase tracking-wider font-bold">
                        <tr>
                            <th class="px-6 py-4">Login użytkownika</th>
                            <th class="px-6 py-4">Rola w systemie</th>
                            <th class="px-6 py-4 hidden sm:table-cell">Identyfikator w bazie</th>
                            <th class="px-6 py-4 text-right">Akcje</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/10 text-sm">
                        @foreach (var user in listaPracownikow)
                        {
                            <tr class="hover:bg-surface-container-highest/40 transition-colors group">
                                <td class="px-6 py-4 font-bold text-on-surface">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold">
                                            @user.UserName?.Substring(0, 1).ToUpper()
                                        </div>
                                        @user.UserName
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-3 py-1 rounded-full text-[10px] uppercase font-bold border bg-primary/10 text-primary border-primary/20">
                                        Pracownik
                                    </span>
                                </td>
                                <td class="px-6 py-4 hidden sm:table-cell text-xs text-on-surface-variant/50 font-mono">@user.Id</td>
                                <td class="px-6 py-4 text-right">
                                    <button class="p-2 rounded-lg text-error/70 hover:bg-error/10 hover:text-error transition-colors border border-transparent hover:border-error/20" title="Zwolnij pracownika" @onclick="@(() => UsunPracownika(user.Id))">
                                        <span class="material-symbols-outlined text-[20px]">person_remove</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private string nowyLogin = "";
    private string noweHaslo = "";
    private string komunikat = "";
    private bool czyBlad = false;

    private List<ApplicationUser> listaPracownikow = new();

    protected override async Task OnInitializedAsync()
    {
        await OdswiezListe();
    }

    private async Task OdswiezListe()
    {
        // Pobieramy wszystkich użytkowników, którzy nie są Właścicielem (dla uproszczenia pobieramy wszystkich)
        listaPracownikow = UserManager.Users.ToList();
    }

    private async Task ZarejestrujPracownika()
    {
        if (string.IsNullOrWhiteSpace(nowyLogin) || string.IsNullOrWhiteSpace(noweHaslo))
        {
            WyswietlKomunikat("Wypełnij wszystkie pola!", true);
            return;
        }
        
        // Tworzymy nowy profil użytkownika
        var nowyUzytkownik = new ApplicationUser
        {
            UserName = nowyLogin,
            Email = nowyLogin + "@sklep.pl",
            EmailConfirmed = true
        };
        
        // Próba zapisu do bazy z hasłem
        var rezultat = await UserManager.CreateAsync(nowyUzytkownik, noweHaslo);

        if (rezultat.Succeeded)
        {
            // Upewniamy się, że rola "Pracownik" istnieje
            if (!await RoleManager.RoleExistsAsync("Pracownik"))
            {
                await RoleManager.CreateAsync(new IdentityRole("Pracownik"));
            }
            
            // Nadajemy rolę pracownika
            await UserManager.AddToRoleAsync(nowyUzytkownik, "Pracownik");

            WyswietlKomunikat($"Konto {nowyLogin} zostało utworzone!", false);
            nowyLogin = "";
            noweHaslo = "";
            await OdswiezListe();
        }
        else
        {
            // Jeśli hasło jest za słabe (np. brak dużej litery), system wyrzuci tu błędy
            var bledy = string.Join(" ", rezultat.Errors.Select(e => e.Description));
            WyswietlKomunikat($"Błąd: {bledy}", true);
        }
    }

    private async Task UsunPracownika(string idDoUsuniecia)
    {
        // 1. Sprawdzamy, kim jest obecny zalogowany Szef
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var nazwaZalogowanego = authState.User.Identity?.Name;

        // 2. Szukamy w bazie pracownika, w którego kliknęliśmy
        var pracownik = await UserManager.FindByIdAsync(idDoUsuniecia);
        
        if (pracownik != null)
        {
            // ZABEZPIECZENIE: Szef nie może usunąć sam siebie!
            if (pracownik.UserName == nazwaZalogowanego)
            {
                WyswietlKomunikat("Błąd: Nie możesz usunąć własnego konta administratora!", true);
                return;
            }

            // 3. Właściwe usunięcie z bazy
            var rezultat = await UserManager.DeleteAsync(pracownik);
            
            if (rezultat.Succeeded)
            {
                WyswietlKomunikat($"Konto pracownika '{pracownik.UserName}' zostało usunięte na zawsze.", false);
                await OdswiezListe(); // Przeładowuje tabelę
            }
            else
            {
                WyswietlKomunikat("Wystąpił problem z usunięciem konta z bazy danych.", true);
            }
        }
    }

    private void WyswietlKomunikat(string tresc, bool blad)
    {
        komunikat = tresc;
        czyBlad = blad;
    }
}