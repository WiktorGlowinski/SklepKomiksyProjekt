@page "/"
@using SklepKomiksy.Models
@using Microsoft.EntityFrameworkCore
@inject SklepKomiksy.Services.ProduktService ProduktService
@inject SklepKomiksy.Data.ApplicationDbContext Context
@inject IJSRuntime JS

<style>
    /* Ten kod uruchamia się TYLKO podczas generowania PDF / drukowania */
    @@media print {
        aside, header, button, a, .glass-effect { 
            display: none !important; 
        }

        body, main, .bg-surface {
            background-color: white !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .bg-surface-container-high, .bg-surface-container, .bg-surface-container-lowest {
            background-color: white !important;
            border: 2px solid #e2e8f0 !important;
            box-shadow: none !important;
            break-inside: avoid; 
        }

        h2, h3, h4, h5, p, span, div {
            color: #111827 !important;
        }

        .grid-cols-1.md\:grid-cols-2.lg\:grid-cols-4 {
            display: flex !important;
            flex-direction: row !important;
            gap: 15px !important;
        }
        .grid-cols-1.md\:grid-cols-2.lg\:grid-cols-4 > div {
            flex: 1 !important;
            min-width: 0 !important;
        }

        @@page {
            margin: 1.5cm;
            size: A4 portrait;
        }
    }
</style>

<div class="mb-10">
    <h2 class="text-3xl font-black text-primary tracking-tight mb-2">Witamy w Centrum Zarządzania</h2>
    <p class="text-on-surface-variant max-w-2xl text-sm">Przeglądaj w czasie rzeczywistym stan swojego archiwum komiksowego. Twoje unikalne tytuły i wartości rynkowe są monitorowane przez silnik The Edge.</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
    <div class="bg-surface-container-high rounded-xl p-6 relative overflow-hidden group">
        <div class="absolute -right-4 -top-4 w-24 h-24 bg-primary/5 rounded-full blur-2xl group-hover:bg-primary/10 transition-all"></div>
        <div class="flex justify-between items-start mb-4">
            <div class="p-3 rounded-xl bg-primary-container">
                <span class="material-symbols-outlined text-primary" data-icon="payments" style="font-variation-settings: 'FILL' 1;">payments</span>
            </div>
        </div>
        <p class="text-on-surface-variant text-[10px] uppercase tracking-wider mb-1 font-bold">Wartość Magazynu</p>
        <h3 class="text-2xl font-black text-on-surface tracking-tight">@WartoscCalkowita.ToString("N2") <span class="text-sm font-normal text-on-surface-variant">PLN</span></h3>
    </div>

    <div class="bg-surface-container-high rounded-xl p-6 relative overflow-hidden group">
        <div class="absolute -right-4 -top-4 w-24 h-24 bg-secondary/5 rounded-full blur-2xl group-hover:bg-secondary/10 transition-all"></div>
        <div class="flex justify-between items-start mb-4">
            <div class="p-3 rounded-xl bg-secondary-container">
                <span class="material-symbols-outlined text-on-secondary-fixed" data-icon="menu_book" style="font-variation-settings: 'FILL' 1;">menu_book</span>
            </div>
        </div>
        <p class="text-on-surface-variant text-[10px] uppercase tracking-wider mb-1 font-bold">Sztuk na Półkach</p>
        <h3 class="text-2xl font-black text-on-surface tracking-tight">@LacznaIloscSztuk <span class="text-sm font-normal text-on-surface-variant">egz.</span></h3>
    </div>

    <div class="bg-surface-container-high rounded-xl p-6 relative overflow-hidden group">
        <div class="absolute -right-4 -top-4 w-24 h-24 bg-tertiary/5 rounded-full blur-2xl group-hover:bg-tertiary/10 transition-all"></div>
        <div class="flex justify-between items-start mb-4">
            <div class="p-3 rounded-xl bg-tertiary-container">
                <span class="material-symbols-outlined text-tertiary" data-icon="stars" style="font-variation-settings: 'FILL' 1;">stars</span>
            </div>
        </div>
        <p class="text-on-surface-variant text-[10px] uppercase tracking-wider mb-1 font-bold">Unikalne Tytuły</p>
        <h3 class="text-2xl font-black text-on-surface tracking-tight">@UnikalneTytuly <span class="text-sm font-normal text-on-surface-variant">serii</span></h3>
    </div>

    <div class="bg-surface-container-high rounded-xl p-6 relative overflow-hidden group">
        <div class="absolute -right-4 -top-4 w-24 h-24 bg-error/5 rounded-full blur-2xl group-hover:bg-error/10 transition-all"></div>
        <div class="flex justify-between items-start mb-4">
            <div class="p-3 rounded-xl bg-error-container">
                <span class="material-symbols-outlined text-error" data-icon="inventory" style="font-variation-settings: 'FILL' 1;">inventory</span>
            </div>
            @if (BrakiWmagazynie > 0)
            {
                <span class="text-[10px] font-bold text-error bg-error/10 px-2 py-1 rounded">Alert</span>
            }
        </div>
        <p class="text-on-surface-variant text-[10px] uppercase tracking-wider mb-1 font-bold">Braki Magazynowe</p>
        <h3 class="text-2xl font-black text-on-surface tracking-tight">@BrakiWmagazynie <span class="text-sm font-normal text-on-surface-variant">pozycji</span></h3>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <div class="lg:col-span-2">
        <AuthorizeView Roles="Wlasciciel">
            <Authorized>
                <div class="bg-surface-container rounded-xl p-8 h-full">
                    <div class="flex justify-between items-center mb-8">
                        <h4 class="text-lg font-bold text-primary">Ostatnie Operacje w Magazynie</h4>
                        <a href="historia" class="text-xs text-secondary font-bold hover:underline">Przejdź do historii</a>
                    </div>
                    
                    <div class="space-y-4">
                        @if (ostatnieLogi == null || !ostatnieLogi.Any())
                        {
                            <p class="text-on-surface-variant text-sm">Brak najnowszych operacji.</p>
                        }
                        else
                        {
                            @foreach (var log in ostatnieLogi)
                            {
                                <div class="bg-surface-container-lowest p-5 rounded-xl flex items-center justify-between group hover:bg-surface-container-high transition-colors border border-outline-variant/5">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 rounded bg-surface-container-highest overflow-hidden shadow-md flex items-center justify-center">
                                            <span class="material-symbols-outlined text-on-surface-variant">@(log.TypAkcji == "Usunięcie" ? "delete" : "menu_book")</span>
                                        </div>
                                        <div>
                                            <h5 class="font-bold text-on-surface">@log.NazwaKomiksu</h5>
                                            <p class="text-xs text-on-surface-variant">Przez: @log.Uzytkownik</p>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm font-bold @(log.TypAkcji == "Usunięcie" ? "text-error" : "text-secondary")">@log.TypAkcji</p>
                                        <p class="text-[10px] text-on-surface-variant uppercase tracking-widest mt-1">@log.DataCzas.ToString("dd.MM HH:mm")</p>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="bg-surface-container rounded-xl p-8 h-full flex flex-col items-center justify-center text-center">
                    <span class="material-symbols-outlined text-4xl text-on-surface-variant/20 mb-4">lock</span>
                    <p class="text-on-surface-variant text-sm italic">Zaloguj się jako Właściciel, aby zobaczyć rejestr operacji.</p>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>

    <div class="space-y-8">
        <div class="glass-effect rounded-xl p-6 border border-outline-variant/10 relative overflow-hidden">
            <div class="relative z-10">
                <h4 class="text-sm font-bold text-on-surface mb-2">Raport bieżący</h4>
                <p class="text-xs text-on-surface-variant mb-4">Pobierz błyskawiczny rzut widoku (PDF) z podsumowaniem wartości archiwum.</p>
                <button @onclick="PobierzPdf" class="w-full bg-surface-container-highest hover:bg-surface-container-high text-on-surface py-2 rounded-lg text-xs font-bold transition-all border border-outline-variant/30 flex justify-center items-center gap-2">
                    <span class="material-symbols-outlined text-sm">download</span> Pobierz PDF
                </button>
            </div>
            <div class="absolute -right-10 -bottom-10 opacity-20 transform rotate-12">
                <span class="material-symbols-outlined text-8xl" data-icon="analytics">analytics</span>
            </div>
        </div>
    </div>
</div>

@code {
    private decimal WartoscCalkowita = 0;
    private int LacznaIloscSztuk = 0;
    private int BrakiWmagazynie = 0;
    private int UnikalneTytuly = 0;

    private List<HistoriaOperacji> ostatnieLogi = new();

    protected override async Task OnInitializedAsync()
    {
        var komiksy = await ProduktService.PobierzKomiksyAsync();
        
        if (komiksy != null && komiksy.Any())
        {
            WartoscCalkowita = komiksy.Sum(k => k.Cena * k.Ilosc);
            LacznaIloscSztuk = komiksy.Sum(k => k.Ilosc);
            BrakiWmagazynie = komiksy.Count(k => k.Ilosc == 0);
            UnikalneTytuly = komiksy.Count;
        }

        ostatnieLogi = await Context.HistorieOperacji
            .OrderByDescending(h => h.DataCzas)
            .Take(3)
            .ToListAsync();
    }

    private async Task PobierzPdf()
    {
        await JS.InvokeVoidAsync("window.print");
    }
}