@page "/autorzy"
@using SklepKomiksy.Models
@using SklepKomiksy.Services
@attribute [Authorize(Roles = "Wlasciciel, Pracownik")]
@inject ProduktService ProduktService

<h3>Zarządzanie Autorami</h3>
<EditForm Model="nowyAutor" OnValidSubmit="ZapiszAutora" class="mb-4 p-3 border rounded">
    <DataAnnotationsValidator />
    <label>Imię:</label> <InputText @bind-Value="nowyAutor.Imie" class="form-control mb-2" />
    <label>Nazwisko:</label> <InputText @bind-Value="nowyAutor.Nazwisko" class="form-control mb-2" />
    <button type="submit" class="btn btn-primary">Dodaj Autora</button>
</EditForm>

@if (listaAutorow != null)
{
    <table class="table table-striped">
        <thead><tr><th>ID</th><th>Imię</th><th>Nazwisko</th></tr></thead>
        <tbody>
            @foreach (var autor in listaAutorow)
            {
                <tr><td>@autor.Id</td><td>@autor.Imie</td><td>@autor.Nazwisko</td></tr>
            }
        </tbody>
    </table>
}

@code {
    private Autor nowyAutor = new();
    private List<Autor>? listaAutorow;
    protected override async Task OnInitializedAsync() => await OdswiezListe();
    private async Task ZapiszAutora() { await ProduktService.DodajAutoraAsync(nowyAutor); nowyAutor = new Autor(); await OdswiezListe(); }
    private async Task OdswiezListe() => listaAutorow = await ProduktService.PobierzAutorowAsync();
}