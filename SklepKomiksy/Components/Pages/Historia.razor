@page "/historia"
@attribute [Authorize(Roles = "Wlasciciel")]
@using SklepKomiksy.Models
@using Microsoft.EntityFrameworkCore
@inject SklepKomiksy.Data.ApplicationDbContext Context

<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h2 class="text-2xl font-black text-primary tracking-tight flex items-center gap-3">
            <span class="material-symbols-outlined">history</span>
            Rejestr Aktywności
        </h2>
        <p class="text-on-surface-variant text-sm mt-1">Śledź każdą operację w magazynie. Sortuj i filtruj zdarzenia.</p>
    </div>

    <div class="relative w-full md:w-96">
        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant/50">person_search</span>
        <input type="text" class="w-full bg-surface-container border border-outline-variant/20 rounded-full pl-12 pr-4 py-2.5 text-sm text-on-surface focus:ring-1 focus:ring-primary focus:border-primary placeholder-on-surface-variant/40 transition-all shadow-sm" placeholder="Szukaj po loginie pracownika..."
               @bind="WyszukiwanyPracownik" @bind:event="oninput" />
    </div>
</div>

<div class="bg-surface-container-high rounded-2xl border border-outline-variant/10 overflow-hidden shadow-lg">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[800px]">
            <thead class="bg-surface-container-highest border-b border-outline-variant/10 text-on-surface-variant text-[11px] uppercase tracking-wider font-bold">
                <tr>
                    <th @onclick='() => Sortuj("Data")' class="px-6 py-4 cursor-pointer hover:text-primary transition-colors select-none">
                        Data i Czas <span class="text-secondary ml-1">@WyswietlIkone("Data")</span>
                    </th>
                    <th @onclick='() => Sortuj("Pracownik")' class="px-6 py-4 cursor-pointer hover:text-primary transition-colors select-none">
                        Pracownik <span class="text-secondary ml-1">@WyswietlIkone("Pracownik")</span>
                    </th>
                    <th class="px-6 py-4">Akcja</th>
                    <th class="px-6 py-4">Komiks</th>
                    <th class="px-6 py-4">Szczegóły</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/10 text-sm">
                @if (!WyswietlaneLogi.Any())
                {
                    <tr><td colspan="5" class="px-6 py-8 text-center text-on-surface-variant"><em>Brak wyników do wyświetlenia.</em></td></tr>
                }
                else
                {
                    @foreach (var wpis in WyswietlaneLogi)
                    {
                        <tr class="hover:bg-surface-container-highest/40 transition-colors">
                            <td class="px-6 py-4 text-xs text-on-surface-variant">@wpis.DataCzas.ToString("dd.MM.yyyy HH:mm:ss")</td>
                            <td class="px-6 py-4 font-bold text-on-surface">@wpis.Uzytkownik</td>
                            <td class="px-6 py-4">
                                <span class="px-3 py-1 rounded-full text-[10px] uppercase font-bold border @(wpis.TypAkcji == "Usunięcie" ? "bg-error/10 text-error border-error/20" : (wpis.TypAkcji == "Dostawa" ? "bg-secondary/10 text-secondary border-secondary/20" : "bg-tertiary/10 text-tertiary border-tertiary/20"))">
                                    @wpis.TypAkcji
                                </span>
                            </td>
                            <td class="px-6 py-4 text-primary font-medium">@wpis.NazwaKomiksu</td>
                            <td class="px-6 py-4 text-xs text-on-surface-variant">@wpis.Szczegoly</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
@code {
    private List<HistoriaOperacji> logi = new();

    // --- ZMIENNE DO FILTROWANIA I SORTOWANIA ---
    public string WyszukiwanyPracownik { get; set; } = "";
    private string aktualnaKolumnaSortowania = "Data";
    private bool rosnaco = false; // Domyślnie sortujemy od najnowszych dat

    // Lista generowana w locie, reagująca na wpisywanie tekstu i klikanie nagłówków
    private IEnumerable<HistoriaOperacji> WyswietlaneLogi
    {
        get
        {
            var wynik = logi.AsEnumerable();

            // 1. Filtrowanie (Wyszukiwanie po loginie)
            if (!string.IsNullOrWhiteSpace(WyszukiwanyPracownik))
            {
                wynik = wynik.Where(h => h.Uzytkownik.Contains(WyszukiwanyPracownik, StringComparison.OrdinalIgnoreCase));
            }

            // 2. Sortowanie
            if (aktualnaKolumnaSortowania == "Pracownik")
            {
                wynik = rosnaco ? wynik.OrderBy(h => h.Uzytkownik) : wynik.OrderByDescending(h => h.Uzytkownik);
            }
            else if (aktualnaKolumnaSortowania == "Data")
            {
                wynik = rosnaco ? wynik.OrderBy(h => h.DataCzas) : wynik.OrderByDescending(h => h.DataCzas);
            }

            return wynik;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Pobieramy ostatnie 200 wpisów do analizy
        logi = await Context.HistorieOperacji
            .OrderByDescending(h => h.DataCzas)
            .Take(200)
            .ToListAsync();
    }

    // --- METODY DO SORTOWANIA ---
    private void Sortuj(string kolumna)
    {
        if (aktualnaKolumnaSortowania == kolumna)
        {
            rosnaco = !rosnaco;
        }
        else
        {
            aktualnaKolumnaSortowania = kolumna;
            rosnaco = true;
        }
    }

    private string WyswietlIkone(string kolumna)
    {
        if (aktualnaKolumnaSortowania != kolumna) return "↕";
        return rosnaco ? "↑" : "↓";
    }
}