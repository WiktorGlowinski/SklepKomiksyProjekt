@page "/historia"
@attribute [Authorize(Roles = "Wlasciciel")]
@using SklepKomiksy.Models
@using Microsoft.EntityFrameworkCore
@inject SklepKomiksy.Data.ApplicationDbContext Context

<h3 class="fw-bold mb-4"><i class="bi bi-clock-history text-primary"></i> Rejestr Aktywności</h3>

<div class="table-responsive shadow-sm bg-white p-3 rounded-3">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Data i Czas</th>
                <th>Pracownik</th>
                <th>Akcja</th>
                <th>Komiks</th>
                <th>Szczegóły</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var wpis in logi)
            {
                <tr>
                    <td><small class="text-muted">@wpis.DataCzas.ToString("dd.MM.yyyy HH:mm:ss")</small></td>
                    <td class="fw-bold">@wpis.Uzytkownik</td>
                    <td>
                        <span class="badge @(wpis.TypAkcji == "Usunięcie" ? "bg-danger" : (wpis.TypAkcji == "Dostawa" ? "bg-success" : "bg-warning text-dark"))">
                            @wpis.TypAkcji
                        </span>
                    </td>
                    <td>@wpis.NazwaKomiksu</td>
                    <td><small>@wpis.Szczegoly</small></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<HistoriaOperacji> logi = new();

    protected override async Task OnInitializedAsync()
    {
        // Pobieramy historię od najnowszej do najstarszej
        logi = await Context.HistorieOperacji
            .OrderByDescending(h => h.DataCzas)
            .Take(100) // Pokazujemy tylko 100 ostatnich akcji
            .ToListAsync();
    }
}