@page "/add"
@attribute [Authorize]
@using SklepKomiksy.Models
@inject SklepKomiksy.Services.ProduktService ProduktService
@inject NavigationManager Navigation

<div class="mb-8">
    <h2 class="text-2xl font-black text-primary tracking-tight flex items-center gap-3">
        <span class="material-symbols-outlined">add_box</span>
        Wprowadź Nowy Komiks
    </h2>
    <p class="text-on-surface-variant text-sm mt-1">Dodaj nową pozycję do archiwum logistycznego. Pola oznaczone gwiazdką (*) są wymagane.</p>
</div>

<div class="bg-surface-container-high rounded-2xl border border-outline-variant/10 p-6 md:p-8 shadow-lg max-w-5xl">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="md:col-span-2 lg:col-span-3">
            <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Tytuł Komiksu *</label>
            <input type="text" class="w-full bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-3 text-sm text-on-surface focus:ring-1 focus:ring-primary focus:border-primary transition-all placeholder-on-surface-variant/30" @bind="nowyKomiks.Tytul" placeholder="np. The Amazing Spider-Man" />
        </div>

        <div>
            <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Numer Zeszytu</label>
            <input type="text" class="w-full bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-3 text-sm text-on-surface focus:ring-1 focus:ring-primary focus:border-primary transition-all placeholder-on-surface-variant/30" @bind="nowyKomiks.NumerZeszytu" placeholder="np. 800" />
        </div>

        <div>
            <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Numer ISBN</label>
            <input type="text" class="w-full bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-3 text-sm text-on-surface focus:ring-1 focus:ring-primary focus:border-primary transition-all placeholder-on-surface-variant/30" @bind="nowyKomiks.ISBN" placeholder="np. 978-83-281-58..." />
        </div>

        <div>
            <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Cena (PLN) *</label>
            <div class="relative">
                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant/50 text-[20px]">payments</span>
                <input type="number" step="0.01" class="w-full bg-surface-container border border-outline-variant/20 rounded-lg pl-11 pr-4 py-3 text-sm text-on-surface focus:ring-1 focus:ring-primary focus:border-primary transition-all" @bind="nowyKomiks.Cena" />
            </div>
        </div>

        <div>
            <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Ilość na start *</label>
            <div class="relative">
                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant/50 text-[20px]">inventory_2</span>
                <input type="number" class="w-full bg-surface-container border border-outline-variant/20 rounded-lg pl-11 pr-4 py-3 text-sm text-on-surface focus:ring-1 focus:ring-primary focus:border-primary transition-all" @bind="nowyKomiks.Ilosc" />
            </div>
        </div>

        <div>
            <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Wydawnictwo</label>
            <select class="w-full bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-3 text-sm text-on-surface focus:ring-1 focus:ring-primary focus:border-primary transition-all" @bind="nowyKomiks.IdWydawnictwa">
                <option value="">-- Wybierz --</option>
                @foreach (var w in dostepneWydawnictwa)
                {
                    <option value="@w.Id">@w.Nazwa</option>
                }
            </select>
        </div>
        
        <div>
            <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Kategoria Wiekowa</label>
            <select class="w-full bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-3 text-sm text-on-surface focus:ring-1 focus:ring-primary focus:border-primary transition-all" @bind="nowyKomiks.IdKategoriiWiekowej">
                <option value="">-- Wybierz --</option>
                @foreach (var k in dostepneKategorie)
                {
                    <option value="@k.Id">@k.Nazwa</option>
                }
            </select>
        </div>

        <div class="md:col-span-2 lg:col-span-3">
            <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Lokalizacja w Magazynie</label>
            <select class="w-full bg-surface-container border border-outline-variant/20 rounded-lg px-4 py-3 text-sm text-on-surface focus:ring-1 focus:ring-primary focus:border-primary transition-all" @bind="nowyKomiks.IdLokalizacji">
                <option value="">-- Brak przypisanej lokalizacji --</option>
                @foreach (var lok in dostepneLokalizacje)
                {
                    <option value="@lok.Id">Regał: @lok.Regal, Półka: @lok.Polka</option>
                }
            </select>
        </div>

        <div class="md:col-span-1 lg:col-span-1">
            <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Autorzy</label>
            <div class="bg-surface-container border border-outline-variant/20 rounded-lg p-4 h-48 overflow-y-auto space-y-3 shadow-inner">
                @foreach (var autor in dostepniAutorzy)
                {
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <input type="checkbox" class="w-4 h-4 rounded border-outline-variant/40 bg-surface-container-high text-primary focus:ring-primary focus:ring-offset-0 transition-colors"
                               @onchange="@((ChangeEventArgs e) => ZaznaczAutora(autor.Id, e.Value))" />
                        <span class="text-sm text-on-surface-variant group-hover:text-on-surface transition-colors">@autor.Imie @autor.Nazwisko</span>
                    </label>
                }
            </div>
        </div>

        <div class="md:col-span-1 lg:col-span-2">
            <label class="block text-xs font-bold text-on-surface-variant uppercase tracking-wider mb-2">Gatunki</label>
            <div class="bg-surface-container border border-outline-variant/20 rounded-lg p-4 h-48 overflow-y-auto shadow-inner">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    @foreach (var gatunek in dostepniGatunki)
                    {
                        <label class="flex items-center gap-3 cursor-pointer group">
                            <input type="checkbox" class="w-4 h-4 rounded border-outline-variant/40 bg-surface-container-high text-primary focus:ring-primary focus:ring-offset-0 transition-colors"
                                   @onchange="@((ChangeEventArgs e) => ZaznaczGatunek(gatunek.Id, e.Value))" />
                            <span class="text-sm text-on-surface-variant group-hover:text-on-surface transition-colors">@gatunek.Nazwa</span>
                        </label>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-8 flex gap-4 justify-end border-t border-outline-variant/10 pt-6">
        <a href="produkty" class="px-6 py-3 rounded-xl text-sm font-bold text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors flex items-center justify-center">
            Anuluj
        </a>
        <button class="primary-gradient text-on-primary font-bold py-3 px-8 rounded-xl flex items-center justify-center gap-2 shadow-lg shadow-on-primary-container/20 hover:scale-[0.98] transition-transform" @onclick="ZapiszKomiks">
            <span class="material-symbols-outlined text-sm">save</span>
            <span>Zapisz w archiwum</span>
        </button>
    </div>
</div>

@code {
    private Produkt nowyKomiks = new();
    
    private List<Autor> dostepniAutorzy = new();
    private List<Gatunek> dostepniGatunki = new();
    private List<Wydawnictwo> dostepneWydawnictwa = new();
    private List<KategoriaWiekowa> dostepneKategorie = new();
    private List<Lokalizacja> dostepneLokalizacje = new();
    
    private List<long> wybraneAutorzyId = new();
    private List<long> wybraneGatunkiId = new();

    protected override async Task OnInitializedAsync()
    {
        // Sprawdzenie i ewentualne dodanie kategorii wiekowych z automatu
        await ProduktService.InicjalizujKategorieWiekoweAsync();

        dostepniAutorzy = await ProduktService.PobierzAutorowAsync();
        dostepniGatunki = await ProduktService.PobierzGatunkiAsync();
        dostepneWydawnictwa = await ProduktService.PobierzWydawnictwaAsync();
        dostepneKategorie = await ProduktService.PobierzKategorieWiekoweAsync();
        dostepneLokalizacje = await ProduktService.PobierzLokalizacjeAsync();
    }

    private void ZaznaczAutora(long id, object? zaznaczony)
    {
        if (zaznaczony is bool isChecked && isChecked)
            wybraneAutorzyId.Add(id);
        else
            wybraneAutorzyId.Remove(id);
    }

    private void ZaznaczGatunek(long id, object? zaznaczony)
    {
        if (zaznaczony is bool isChecked && isChecked)
            wybraneGatunkiId.Add(id);
        else
            wybraneGatunkiId.Remove(id);
    }

    private async Task ZapiszKomiks()
    {
        await ProduktService.DodajKomiksAsync(nowyKomiks, wybraneAutorzyId.ToArray(), wybraneGatunkiId.ToArray());
        Navigation.NavigateTo("/produkty");
    }
}