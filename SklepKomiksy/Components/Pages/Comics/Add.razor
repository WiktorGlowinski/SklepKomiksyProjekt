@page "/add"
@attribute [Authorize]
@using SklepKomiksy.Models
@using Microsoft.AspNetCore.Components.Forms
@inject SklepKomiksy.Services.ProduktService ProduktService
@inject NavigationManager Navigation

<h3>Dodaj Nowy Komiks do Magazynu</h3>
<hr />

<EditForm Model="nowyKomiks" OnValidSubmit="ZapiszKomiks">
    <div class="row">
        
        <div class="col-md-6">
            
            <div class="mb-3">
                <label class="form-label fw-bold">Tytuł komiksu:</label>
                <InputText @bind-Value="nowyKomiks.Tytul" class="form-control" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Numer ISBN:</label>
                    <InputText @bind-Value="nowyKomiks.ISBN" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Cena (zł):</label>
                    <InputNumber @bind-Value="nowyKomiks.Cena" class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Ilość w magazynie:</label>
                    <InputNumber @bind-Value="nowyKomiks.Ilosc" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Numer zeszytu:</label>
                    <InputNumber @bind-Value="nowyKomiks.NumerZeszytu" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Wydawnictwo:</label>
                <InputSelect TValue="int?" @bind-Value="nowyKomiks.IdWydawnictwa" class="form-select">
                    <option value="">-- Wybierz Wydawnictwo --</option>
                    @foreach (var wyd in dostepneWydawnictwa)
                    {
                        <option value="@wyd.Id">@wyd.Nazwa</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Kategoria Wiekowa:</label>
                <InputSelect TValue="int?" @bind-Value="nowyKomiks.IdKategoriiWiekowej" class="form-select">
                    <option value="">-- Wybierz Kategorię --</option>
                    @foreach (var kat in dostepneKategorie)
                    {
                        <option value="@kat.Id">@kat.Nazwa</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Lokalizacja w magazynie:</label>
                <InputSelect TValue="int?" @bind-Value="nowyKomiks.IdLokalizacji" class="form-select">
                    <option value="">-- Wybierz Regał i Półkę --</option>
                    @foreach (var lok in dostepneLokalizacje)
                    {
                        <option value="@lok.Id">Regał: @lok.Regal, Półka: @lok.Polka</option>
                    }
                </InputSelect>
            </div>
            
            <button type="submit" class="btn btn-success mt-4 w-100 fs-5">
                <i class="bi bi-save"></i> Zapisz Komiks w Bazie
            </button>
            
        </div>

        <div class="col-md-6">
            
            <div class="card mb-3">
                <div class="card-header bg-dark text-white">Wybierz Autorów</div>
                <div class="card-body" style="max-height: 200px; overflow-y: auto;">
                    @if (dostepniAutorzy != null)
                    {
                        @foreach (var autor in dostepniAutorzy)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="autor_@autor.Id"
                                       @onchange="@(e => ZaznaczAutora(autor.Id, e.Value))" />
                                <label class="form-check-label" for="autor_@autor.Id">
                                    @autor.Imie @autor.Nazwisko
                                </label>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header bg-dark text-white">Wybierz Gatunki</div>
                <div class="card-body" style="max-height: 200px; overflow-y: auto;">
                    @if (dostepniGatunki != null)
                    {
                        @foreach (var gatunek in dostepniGatunki)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="gatunek_@gatunek.Id"
                                       @onchange="@(e => ZaznaczGatunek(gatunek.Id, e.Value))" />
                                <label class="form-check-label" for="gatunek_@gatunek.Id">
                                    @gatunek.Nazwa
                                </label>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>
    </div>
</EditForm>

@code {
    private Produkt nowyKomiks = new();
    
    private List<Autor> dostepniAutorzy = new();
    private List<Gatunek> dostepniGatunki = new();
    private List<Wydawnictwo> dostepneWydawnictwa = new();
    private List<KategoriaWiekowa> dostepneKategorie = new();
    private List<Lokalizacja> dostepneLokalizacje = new();
    
    private List<long> wybraneAutorzyId = new();
    private List<long> wybraneGatunkiId = new();

    protected override async Task OnInitializedAsync()
    {
        // Sprawdzenie i ewentualne dodanie kategorii wiekowych z automatu
        await ProduktService.InicjalizujKategorieWiekoweAsync();

        dostepniAutorzy = await ProduktService.PobierzAutorowAsync();
        dostepniGatunki = await ProduktService.PobierzGatunkiAsync();
        dostepneWydawnictwa = await ProduktService.PobierzWydawnictwaAsync();
        dostepneKategorie = await ProduktService.PobierzKategorieWiekoweAsync();
        dostepneLokalizacje = await ProduktService.PobierzLokalizacjeAsync();
    }

    private void ZaznaczAutora(long id, object? zaznaczony)
    {
        if (zaznaczony is bool isChecked && isChecked)
            wybraneAutorzyId.Add(id);
        else
            wybraneAutorzyId.Remove(id);
    }

    private void ZaznaczGatunek(long id, object? zaznaczony)
    {
        if (zaznaczony is bool isChecked && isChecked)
            wybraneGatunkiId.Add(id);
        else
            wybraneGatunkiId.Remove(id);
    }

    private async Task ZapiszKomiks()
    {
        await ProduktService.DodajKomiksAsync(nowyKomiks, wybraneAutorzyId.ToArray(), wybraneGatunkiId.ToArray());
        Navigation.NavigateTo("/produkty");
    }
}