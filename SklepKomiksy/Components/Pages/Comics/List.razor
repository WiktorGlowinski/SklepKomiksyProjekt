@page "/produkty" 
@using SklepKomiksy.Models
@inject SklepKomiksy.Services.ProduktService ProduktService
@inject AuthenticationStateProvider AuthStateProvider

<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h2 class="text-2xl font-black text-primary tracking-tight flex items-center gap-3">
            <span class="material-symbols-outlined">inventory_2</span>
            Stan Magazynu
        </h2>
        <p class="text-on-surface-variant text-sm mt-1">Zarządzaj swoimi zasobami. Kliknij nagłówki, aby sortować.</p>
    </div>

    <div class="relative w-full md:w-96">
        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant/50">search</span>
        <input type="text" class="w-full bg-surface-container border border-outline-variant/20 rounded-full pl-12 pr-4 py-2.5 text-sm text-on-surface focus:ring-1 focus:ring-primary focus:border-primary placeholder-on-surface-variant/40 transition-all shadow-sm" placeholder="Szukaj po tytule komiksu..."
               @bind="WyszukiwanaFraza" @bind:event="oninput" />
    </div>
</div>

<div class="bg-surface-container-high rounded-2xl border border-outline-variant/10 overflow-hidden shadow-lg">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[1000px]">
            <thead class="bg-surface-container-highest border-b border-outline-variant/10 text-on-surface-variant text-[11px] uppercase tracking-wider font-bold">
                <tr>
                    <th @onclick='() => Sortuj("Tytul")' class="px-4 py-4 cursor-pointer hover:text-primary transition-colors select-none">
                        Tytuł <span class="text-secondary ml-1">@WyswietlIkoneSortowania("Tytul")</span>
                    </th>
                    <th @onclick='() => Sortuj("Zeszyt")' class="px-4 py-4 cursor-pointer hover:text-primary transition-colors select-none">
                        Zeszyt <span class="text-secondary ml-1">@WyswietlIkoneSortowania("Zeszyt")</span>
                    </th>
                    <th class="px-4 py-4">ISBN</th>
                    <th class="px-4 py-4">Cena</th>
                    <th class="px-4 py-4 text-center">Ilość</th>
                    <th @onclick='() => Sortuj("Wydawnictwo")' class="px-4 py-4 cursor-pointer hover:text-primary transition-colors select-none">
                        Wydawnictwo <span class="text-secondary ml-1">@WyswietlIkoneSortowania("Wydawnictwo")</span>
                    </th>
                    <th class="px-4 py-4">Kategoria</th>
                    <th class="px-4 py-4">Lokalizacja</th>
                    <th @onclick='() => Sortuj("Autorzy")' class="px-4 py-4 cursor-pointer hover:text-primary transition-colors select-none">
                        Autorzy <span class="text-secondary ml-1">@WyswietlIkoneSortowania("Autorzy")</span>
                    </th>
                    <AuthorizeView Roles="Wlasciciel">
                        <th class="px-4 py-4 text-right">Akcje</th>
                    </AuthorizeView>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/10 text-sm">
                @if (komiksy == null)
                {
                    <tr><td colspan="10" class="px-6 py-8 text-center text-on-surface-variant"><em>Inicjowanie połączenia z the Archive...</em></td></tr>
                }
                else if (!WyswietlaneKomiksy.Any())
                {
                    <tr><td colspan="10" class="px-6 py-8 text-center text-error font-medium"><em>Brak wyników w archiwum.</em></td></tr>
                }
                else
                {
                    @foreach (var komiks in WyswietlaneKomiksy)
                    {
                        <tr class="hover:bg-surface-container-highest/40 transition-colors group">
                            <td class="px-4 py-3 font-bold text-on-surface">@komiks.Tytul</td>
                            <td class="px-4 py-3 text-on-surface-variant">#@komiks.NumerZeszytu</td>
                            <td class="px-4 py-3 text-xs text-on-surface-variant/70">@komiks.ISBN</td>
                            <td class="px-4 py-3 text-secondary font-medium">@komiks.Cena.ToString("F2") zł</td>
                            
                            <td class="px-4 py-3">
                                <div class="flex items-center justify-center gap-2">
                                    <button class="w-7 h-7 rounded flex items-center justify-center bg-surface-container border border-outline-variant/20 text-on-surface hover:bg-error hover:text-on-error hover:border-error transition-colors" @onclick="@(() => ZmienIlosc(komiks.Id, -1))">
                                        <span class="material-symbols-outlined text-[16px]">remove</span>
                                    </button>
                                    
                                    <span class="px-3 py-1 rounded-full text-xs font-bold border @(komiks.Ilosc > 0 ? "bg-secondary/10 text-secondary border-secondary/20" : "bg-error/10 text-error border-error/20") min-w-[50px] text-center">
                                        @komiks.Ilosc szt.
                                    </span>
                                    
                                    <button class="w-7 h-7 rounded flex items-center justify-center bg-surface-container border border-outline-variant/20 text-on-surface hover:bg-secondary hover:text-on-secondary hover:border-secondary transition-colors" @onclick="@(() => ZmienIlosc(komiks.Id, 1))">
                                        <span class="material-symbols-outlined text-[16px]">add</span>
                                    </button>
                                </div>
                            </td>

                            <td class="px-4 py-3 text-on-surface-variant">@PobierzNazweWydawnictwa(komiks.IdWydawnictwa)</td>
                            <td class="px-4 py-3">
                                <span class="bg-surface-container-lowest border border-outline-variant/20 text-on-surface-variant px-2 py-1 rounded text-xs">@PobierzNazweKategorii(komiks.IdKategoriiWiekowej)</span>
                            </td>
                            
                            <td class="px-4 py-3">
                                <select class="bg-surface-container border border-outline-variant/20 text-on-surface text-xs rounded-lg focus:ring-primary focus:border-primary block w-full py-1.5 px-2"
                                        value="@komiks.IdLokalizacji"
                                        @onchange="@((ChangeEventArgs e) => ZmienLokalizacje(komiks.Id, e.Value))">
                                    <option value="">-- Brak --</option>
                                    @if (lokalizacje != null)
                                    {
                                        @foreach (var lok in lokalizacje)
                                        {
                                            <option value="@lok.Id">Reg: @lok.Regal, Pół: @lok.Polka</option>
                                        }
                                    }
                                </select>
                            </td>

                            <td class="px-4 py-3 text-xs text-on-surface-variant">@string.Join(", ", komiks.Autorzy.Select(a => $"{a.Imie} {a.Nazwisko}"))</td>

                            <AuthorizeView Roles="Wlasciciel" Context="authContext">
                                <Authorized>
                                    <td class="px-4 py-3 text-right">
                                        <button class="p-1.5 rounded text-error/70 hover:bg-error/10 hover:text-error transition-colors opacity-0 group-hover:opacity-100 focus:opacity-100" title="Usuń pozycję" @onclick="@(() => UsunKomiks(komiks.Id))">
                                            <span class="material-symbols-outlined text-[20px]">delete</span>
                                        </button>
                                    </td>
                                </Authorized>
                            </AuthorizeView>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private string nazwaZalogowanego = "Nieznany";
    private List<Produkt>? komiksy;
    private List<Wydawnictwo> wydawnictwa = new();
    private List<KategoriaWiekowa> kategorie = new();
    private List<Lokalizacja> lokalizacje = new();

    // --- ZMIENNE DO WYSZUKIWANIA I SORTOWANIA ---
    public string WyszukiwanaFraza { get; set; } = "";
    private string aktualnaKolumnaSortowania = "";
    private bool rosnaco = true;

    // To jest "serce" operacji – lista generowana w locie na podstawie tego, co wpiszesz i klikniesz
    private IEnumerable<Produkt> WyswietlaneKomiksy
    {
        get
        {
            if (komiksy == null) return Enumerable.Empty<Produkt>();

            var wynik = komiksy.AsEnumerable();

            // 1. Filtrowanie (Wyszukiwanie po tytule)
            if (!string.IsNullOrWhiteSpace(WyszukiwanaFraza))
            {
                wynik = wynik.Where(k => k.Tytul.Contains(WyszukiwanaFraza, StringComparison.OrdinalIgnoreCase));
            }

            // 2. Sortowanie
            switch (aktualnaKolumnaSortowania)
            {
                case "Tytul":
                    wynik = rosnaco ? wynik.OrderBy(k => k.Tytul) : wynik.OrderByDescending(k => k.Tytul);
                    break;
                case "Zeszyt":
                    wynik = rosnaco ? wynik.OrderBy(k => k.NumerZeszytu) : wynik.OrderByDescending(k => k.NumerZeszytu);
                    break;
                case "Wydawnictwo":
                    wynik = rosnaco ? wynik.OrderBy(k => PobierzNazweWydawnictwa(k.IdWydawnictwa)) 
                                    : wynik.OrderByDescending(k => PobierzNazweWydawnictwa(k.IdWydawnictwa));
                    break;
                case "Autorzy":
                    // Sortujemy połączony tekst nazwisk autorów
                    wynik = rosnaco ? wynik.OrderBy(k => string.Join("", k.Autorzy.Select(a => a.Nazwisko))) 
                                    : wynik.OrderByDescending(k => string.Join("", k.Autorzy.Select(a => a.Nazwisko)));
                    break;
            }

            return wynik;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // 1. Pobieramy dane zalogowanego użytkownika
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        nazwaZalogowanego = authState.User.Identity?.Name ?? "Nieznany";

        // 2. Pobieramy dane do tabeli
        komiksy = await ProduktService.PobierzKomiksyAsync();
        wydawnictwa = await ProduktService.PobierzWydawnictwaAsync();
        kategorie = await ProduktService.PobierzKategorieWiekoweAsync();
        lokalizacje = await ProduktService.PobierzLokalizacjeAsync();
    }

    // --- METODY DO SORTOWANIA (bez zmian) ---
    private void Sortuj(string nazwaKolumny)
    {
        if (aktualnaKolumnaSortowania == nazwaKolumny)
        {
            rosnaco = !rosnaco;
        }
        else
        {
            aktualnaKolumnaSortowania = nazwaKolumny;
            rosnaco = true;
        }
    }

    private string WyswietlIkoneSortowania(string nazwaKolumny)
    {
        if (aktualnaKolumnaSortowania != nazwaKolumny) return "↕";
        return rosnaco ? "↑" : "↓";
    }

    // --- METODY ZMIENIAJĄCE DANE (TUTAJ JEST ZMIANA!) ---
    private async Task ZmienIlosc(long id, int zmiana)
    {
        // Dodajemy nazwaZalogowanego jako trzeci parametr
        await ProduktService.ZmienIloscAsync(id, zmiana, nazwaZalogowanego);
        komiksy = await ProduktService.PobierzKomiksyAsync();
    }

    private async Task ZmienLokalizacje(long komiksId, object? nowaWartosc)
    {
        int? noweId = null;
        if (nowaWartosc != null && int.TryParse(nowaWartosc.ToString(), out int parsedId))
        {
            noweId = parsedId;
        }
        await ProduktService.ZmienLokalizacjeAsync(komiksId, noweId);
        komiksy = await ProduktService.PobierzKomiksyAsync();
    }

    private async Task UsunKomiks(long id)
    {
        // Dodajemy nazwaZalogowanego jako drugi parametr
        await ProduktService.UsunKomiksAsync(id, nazwaZalogowanego);
        komiksy = await ProduktService.PobierzKomiksyAsync();
    }

    // --- FUNKCJE POMOCNICZE ---
    private string PobierzNazweWydawnictwa(int? id) => wydawnictwa.FirstOrDefault(w => w.Id == id)?.Nazwa ?? "---";
    private string PobierzNazweKategorii(int? id) => kategorie.FirstOrDefault(k => k.Id == id)?.Nazwa ?? "---";
    
    private string PobierzNazweLokalizacji(int? id)
    {
        var loc = lokalizacje.FirstOrDefault(l => l.Id == id);
        return loc == null ? "---" : $"Regał: {loc.Regal}, Półka: {loc.Polka}";
    }
    [SupplyParameterFromQuery]
    public string? Szukaj { get; set; }

    // 2. Ta metoda uruchamia się automatycznie, gdy wchodzisz na stronę
    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Szukaj))
        {
            WyszukiwanaFraza = Szukaj;
            // Tutaj możesz odświeżyć tabelę, jeśli Twoje Property tego wymaga,
            // ale zazwyczaj przypisanie do WyszukiwanaFraza wystarczy!
        }
    }
    }